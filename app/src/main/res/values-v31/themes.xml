<resources>
    <style name="Theme.Hak3" parent="android:Theme.Material.NoActionBar">
        <item name="android:statusBarColor">#000000</item>
        <item name="android:navigationBarColor">#000000</item>
        <item name="android:windowBackground">#000000</item>
        <!-- 첫 화면. 그림만 세우고 바탕은 아이콘 판과 같은 먹빛으로 둔다 —
             둘이 같은 색이라 런처에서 앱이 열릴 때 판이 그대로 이어진다.
             그림은 판(288dp) 안에서 143dp 로, 도려내는 원(192dp) 안에 든다. -->
        <item name="android:windowSplashScreenBackground">#21252D</item>
        <item name="android:windowSplashScreenAnimatedIcon">@drawable/splash_icon</item>
    </style>
</resources>
